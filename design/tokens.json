{
  "schema": 3,
  "baseMode": "light",
  "color": {
    "transparent": "transparent",
    "white": "#FFFFFF",
    "black": "#000000",
    "gray": {
      "50": "#FAFAFA",
      "100": "#F5F5F5",
      "200": "#E5E5E5",
      "400": "#B3B3B3",
      "600": "#666666",
      "800": "#262626",
      "850": "#1F1F1F",
      "900": "#0A0A0A",
      "950": "#050505"
    },
    "red": {
      "100": "#FFE5E5",
      "400": "#FF3333",
      "500": "#FF0000",
      "600": "#E60000",
      "700": "#DB0000",
      "800": "#CC0000",
      "900": "#A30000"
    },
    "yarn": {
      "300": "#FF6B6B",
      "500": "#E8484A",
      "700": "#C9343A"
    },
    "yellow": {
      "100": "#FFF3CC",
      "400": "#FFC619",
      "500": "#FFBF00"
    },
    "moss": {
      "400": "#628462",
      "500": "#476B47"
    },
    "clay": {
      "400": "#A67359",
      "500": "#8F583D"
    },
    "bg": "$color.white",
    "surface": "$color.white",
    "surfaceSunken": "$color.gray.100",
    "sidebar": "$color.gray.50",
    "text": "$color.black",
    "textMuted": "$color.gray.600",
    "border": "$color.black",
    "borderSubtle": "$color.gray.200",
    "accent": "$color.red.700",
    "accentHover": "$color.red.800",
    "accentSubtle": "$color.red.100",
    "onAccent": "$color.white",
    "inverse": "$color.black",
    "onInverse": "$color.white",
    "highlight": "$color.yellow.500",
    "highlightSubtle": "$color.yellow.100",
    "onHighlight": "$color.black",
    "success": "$color.moss.500",
    "danger": "$color.red.800",
    "onDanger": "$color.white",
    "stitchFilled": "$color.black",
    "stitchChain": "$color.white",
    "stitchGrid": "$color.gray.400",
    "stitchDone": "$color.gray.200",
    "stitchDoneFilled": "$color.gray.600",
    "stitchCurrent": "$color.yellow.500"
  },
  "space": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "px": 1,
    "xs": 2
  },
  "radius": {
    "none": 0,
    "full": 9999
  },
  "shadow": {
    "none": "none",
    "xs": "2px 2px 0px 0px rgb(0 0 0 / 1)",
    "sm": "3px 3px 0px 0px rgb(0 0 0 / 1)",
    "md": "4px 4px 0px 0px rgb(0 0 0 / 1)",
    "lg": "6px 6px 0px 0px rgb(0 0 0 / 1)"
  },
  "border": {
    "default": {
      "width": 2,
      "color": "$color.border",
      "style": "solid"
    },
    "thin": {
      "width": 1,
      "color": "$color.border",
      "style": "solid"
    },
    "subtle": {
      "width": 1,
      "color": "$color.borderSubtle",
      "style": "solid"
    },
    "accent": {
      "width": 2,
      "color": "$color.accent",
      "style": "solid"
    },
    "focus": {
      "width": 2,
      "color": "$color.red.600",
      "style": "solid"
    },
    "dashed": {
      "width": 2,
      "color": "$color.border",
      "style": "dashed"
    }
  },
  "font": {
    "display": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 44,
      "weight": 900,
      "lineHeight": 1,
      "letterSpacing": -1.8
    },
    "h1": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 30,
      "weight": 800,
      "lineHeight": 1.1,
      "letterSpacing": -1
    },
    "h2": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 22,
      "weight": 800,
      "lineHeight": 1.2,
      "letterSpacing": -0.6
    },
    "h3": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 17,
      "weight": 700,
      "lineHeight": 1.3,
      "letterSpacing": -0.4
    },
    "body": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 15,
      "weight": 400,
      "lineHeight": 1.5,
      "letterSpacing": -0.3
    },
    "bodyStrong": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 15,
      "weight": 600,
      "lineHeight": 1.5,
      "letterSpacing": -0.3
    },
    "small": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 13,
      "weight": 400,
      "lineHeight": 1.45,
      "letterSpacing": -0.2
    },
    "smallStrong": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 13,
      "weight": 600,
      "lineHeight": 1.45,
      "letterSpacing": -0.2
    },
    "label": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 11,
      "weight": 800,
      "lineHeight": 1.3,
      "letterSpacing": 0.8
    },
    "button": {
      "family": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
      "size": 14,
      "weight": 700,
      "lineHeight": 1.2,
      "letterSpacing": -0.2
    },
    "counter": {
      "family": "'SF Mono', 'Courier New', monospace",
      "size": 40,
      "weight": 700,
      "lineHeight": 1,
      "letterSpacing": -1.5
    },
    "mono": {
      "family": "'SF Mono', 'Courier New', monospace",
      "size": 13,
      "weight": 500,
      "lineHeight": 1.45
    },
    "monoSmall": {
      "family": "'SF Mono', 'Courier New', monospace",
      "size": 11,
      "weight": 500,
      "lineHeight": 1.4
    }
  },
  "modes": {
    "dark": {
      "color": {
        "bg": "$color.black",
        "surface": "$color.gray.900",
        "surfaceSunken": "$color.gray.850",
        "sidebar": "$color.gray.950",
        "text": "$color.white",
        "textMuted": "$color.gray.400",
        "border": "$color.white",
        "borderSubtle": "$color.gray.800",
        "accent": "$color.red.500",
        "accentHover": "$color.red.600",
        "accentSubtle": "$color.red.900",
        "inverse": "$color.white",
        "onInverse": "$color.black",
        "highlight": "$color.yellow.400",
        "highlightSubtle": "$color.gray.850",
        "success": "$color.moss.400",
        "danger": "$color.red.400"
      },
      "shadow": {
        "xs": "2px 2px 0px 0px rgb(255 255 255 / 1)",
        "sm": "3px 3px 0px 0px rgb(255 255 255 / 1)",
        "md": "4px 4px 0px 0px rgb(255 255 255 / 1)",
        "lg": "6px 6px 0px 0px rgb(255 255 255 / 1)"
      }
    }
  }
}