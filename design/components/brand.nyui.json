{
  "schema": 3,
  "name": "Brand",
  "meta": {
    "group": "Foundations",
    "order": 0,
    "status": "draft",
    "description": "Logo lockups and the colour story: ink black, paper white, yarn red, highlight yellow.",
    "usage": {
      "do": [
        "Put the small lockup top-left of every screen."
      ],
      "dont": [
        "Recolour the yarn ball.",
        "Set the wordmark in anything but Inter Black."
      ]
    }
  },
  "components": {
    "Logo": {
      "description": "The yarn ball and the KNIT PIXEL wordmark. PIXEL is always red.",
      "props": {
        "size": {
          "type": "enum",
          "of": [
            "mark",
            "sm",
            "lg"
          ],
          "default": "sm",
          "description": "mark: the yarn ball alone, for phone headers."
        }
      },
      "root": {
        "id": "root",
        "type": "box",
        "layout": "stack",
        "direction": "row",
        "align": "center",
        "gap": {
          "match": {
            "prop": "size"
          },
          "cases": {
            "mark": 0,
            "sm": "$space.2",
            "lg": "$space.3"
          }
        },
        "children": [
          {
            "id": "mark",
            "type": "image",
            "src": "data:image/png;base64,",
            "width": {
              "match": {
                "prop": "size"
              },
              "cases": {
                "mark": 32,
                "sm": 36,
                "lg": 72
              }
            },
            "height": {
              "match": {
                "prop": "size"
              },
              "cases": {
                "mark": 32,
                "sm": 36,
                "lg": 72
              }
            },
            "fit": "contain"
          },
          {
            "id": "word",
            "type": "text",
            "font": {
              "match": {
                "prop": "size"
              },
              "cases": {
                "mark": "$font.h3",
                "sm": "$font.h3",
                "lg": "$font.display"
              }
            },
            "textTransform": "uppercase",
            "value": {
              "match": {
                "prop": "size"
              },
              "cases": {
                "mark": "",
                "sm": [
                  "Knit ",
                  {
                    "text": "Pixel",
                    "color": "$color.accent"
                  }
                ],
                "lg": [
                  "Knit ",
                  {
                    "text": "Pixel",
                    "color": "$color.accent"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "artboards": [
    {
      "id": "brand-specimens",
      "name": "Brand — lockups and palette",
      "size": {
        "width": 760,
        "height": "auto"
      },
      "background": "$color.bg",
      "root": {
        "id": "root",
        "type": "box",
        "layout": "stack",
        "direction": "column",
        "gap": "$space.8",
        "padding": "$space.8",
        "children": [
          {
            "id": "lg",
            "use": "Logo",
            "props": {
              "size": "lg"
            }
          },
          {
            "id": "sm",
            "use": "Logo",
            "props": {
              "size": "sm"
            }
          },
          {
            "id": "mk",
            "use": "Logo",
            "props": {
              "size": "mark"
            }
          },
          {
            "id": "palette",
            "type": "box",
            "layout": "grid",
            "columns": 6,
            "gap": "$space.3",
            "children": [
              {
                "id": "sw-ink",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-ink-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.black",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-ink-n",
                    "type": "text",
                    "value": "Ink",
                    "font": "$font.smallStrong"
                  }
                ]
              },
              {
                "id": "sw-paper",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-paper-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.white",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-paper-n",
                    "type": "text",
                    "value": "Paper",
                    "font": "$font.smallStrong"
                  }
                ]
              },
              {
                "id": "sw-yarn",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-yarn-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.accent",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-yarn-n",
                    "type": "text",
                    "value": "Yarn red",
                    "font": "$font.smallStrong"
                  }
                ]
              },
              {
                "id": "sw-hi",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-hi-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.highlight",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-hi-n",
                    "type": "text",
                    "value": "Highlight",
                    "font": "$font.smallStrong"
                  }
                ]
              },
              {
                "id": "sw-moss",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-moss-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.moss.500",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-moss-n",
                    "type": "text",
                    "value": "Moss",
                    "font": "$font.smallStrong"
                  }
                ]
              },
              {
                "id": "sw-clay",
                "type": "box",
                "layout": "stack",
                "direction": "column",
                "gap": "$space.2",
                "children": [
                  {
                    "id": "sw-clay-c",
                    "type": "box",
                    "height": 72,
                    "background": "$color.clay.500",
                    "border": "$border.default",
                    "shadow": "$shadow.sm"
                  },
                  {
                    "id": "sw-clay-n",
                    "type": "text",
                    "value": "Clay",
                    "font": "$font.smallStrong"
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
